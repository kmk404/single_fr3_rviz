<?xml version="1.0" encoding="utf-8"?>
<robot name="fr3">
  <group name="fr3_arm">
    <chain base_link="fr3_link0" tip_link="fr3_link8"/>
  </group>

  <group_state name="ready" group="fr3_arm">
    <joint name="fr3_joint1" value="0.0"/>
    <joint name="fr3_joint2" value="-0.7853981634"/>
