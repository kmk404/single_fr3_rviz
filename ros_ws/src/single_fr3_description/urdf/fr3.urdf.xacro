<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">
  <!-- Geometry and limits are supplied by the pinned official franka_description. -->
  <xacro:arg name="robot_ip" default=""/>
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="hand" default="false"/>
  <xacro:arg name="is_async" default="false"/>
  <xacro:arg name="thread_priority" default="98"/>

  <xacro:include filename="$(find franka_description)/robots/fr3/fr3.urdf.xacro"/>
  <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm.ros2_control.xacro"/>
  <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm_hardware_plugins.xacro"/>

  <xacro:franka_arm_ros2_control
      robot_type="fr3"
      include_effort_command="true"
      include_finger_joint="false"
      arm_prefix=""
      is_async="$(arg is_async)"
      thread_priority="$(arg thread_priority)">
    <hardware_plugin>
      <xacro:if value="$(arg use_fake_hardware)">
        <xacro:franka_mock_hardware_plugin
            fake_sensor_commands="$(arg fake_sensor_commands)"/>
      </xacro:if>
      <xacro:unless value="$(arg use_fake_hardware)">
        <xacro:franka_real_hardware_plugin robot_ip="$(arg robot_ip)" arm_prefix=""/>
      </xacro:unless>
    </hardware_plugin>
  </xacro:franka_arm_ros2_control>
</robot>
